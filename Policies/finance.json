{
    "Version" : "2012-10-17",
    "Statement" : [
      {
        "Sid" : "FinanceS3List",
        "Effect" : "Allow",
        "Action" : [
          "s3:ListBucket"
        ],
        "Resource" : "arn:aws:s3:::fincore-lab-finance-data"
      },
      {
        "Sid" : "FinanceS3Download",
        "Effect" : "Allow",
        "Action" : [
          "s3:GetObject"
        ],
        "Resource" : "arn:aws:s3:::fincore-lab-finance-data/*"
      }
    ]
  }